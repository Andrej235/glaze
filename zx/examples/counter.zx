pub const Counter = struct  {
    count = 0,

    fn increment(self: *Counter) void {
        if(self.count <= 10)
            self.count += 1;
    }

    fn render(self: *Counter) !*UIElement {
        return (
            <div className= {counter} test2=    {123}             >
                <text>{self.count} clicks</text>
                <div>
                    <button onClick     ={self.increment} test2={123}    test4>Click me!</button>
                    <SelfClosing my_boolean ={true}a1sd={asd}    />
                </div>
            </div>
        );
    }
};
